  "version": "1.0.0",
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.jsx",
    "typecheck": "tsc --noEmit --project jsconfig.json",
    "fixtures:check": "echo \"No fixtures drift check configured for this repo\"",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:unit:ci": "vitest run test/unit --coverage",
    "test:integration": "vitest run test/integration",
    "test:integration:ci": "vitest run test/integration --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
